# Konfigurasi Server LuLuSin-API
PORT=3002
NODE_ENV=production
SESSION_SECRET=LuLusinSecretSessionKey2026
SECRET_KEY=LuLuSinJwtSecretKey2026

# Konfigurasi Database (TiDB Cloud Serverless / MySQL 8.0)
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=xxxxxx.root
DB_PASS=xxxxxx
DB_NAME=db_lulusin
DB_DIALECT=mysql
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# Konfigurasi CORS (pisahkan domain dengan tanda koma)
FRONTEND_URL=https://lulusin-rahdan.pages.dev,http://localhost:5173,http://127.0.0.1:5173

# Konfigurasi Optimasi Scraper Dashboard
# Set true agar container tidak meluncurkan browser Chromium yang memakan RAM
DISABLE_PUPPETEER_SCRAPER=true
SNBT_TARGET_DATE=2026-05-02
